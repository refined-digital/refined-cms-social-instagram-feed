{
  "name": "@refineddigital/cms-social-instagram-feed",
  "version": "1.4.0",
  "description": "Instagram feed for Refined CMS",
  "main": "resources/js/instagram-feed.js",
  "type": "module",
  "scripts": {
    "build": "esbuild resources/js/main.js --bundle --format=iife --target=es2019 --minify --outfile=assets/js/main.js",
    "publish-and-tag": "git push --tags && git push origin master",
    "version:patch": "npm version patch && npm run publish-and-tag",
    "version:minor": "npm version minor && npm run publish-and-tag",
    "version:marjor": "npm version major && npm run publish-and-tag"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/refineddigital/refined-cms-social-instagram-feed.git"
  },
  "author": "Matthias Law",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/refineddigital/refined-cms-social-instagram-feed/issues"
  },
  "homepage": "https://github.com/refineddigital/refined-cms-social-instagram-feed#readme",
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
